digraph sottrace {
  rankdir=LR;
  "p0" [label="pid 0\ntier 0", shape=box];
  "p1" [label="pid 1\ntier 0", shape=box];
  "f:/etc/crontab" [label="/etc/crontab", shape=ellipse];
  "f:/etc/systemd/system/backdoor.service" [label="/etc/systemd/system/backdoor.service", shape=ellipse];
  "f:/etc/systemd/system/backdoor.timer" [label="/etc/systemd/system/backdoor.timer", shape=ellipse];
  "f:/hello-libc.c" [label="/hello-libc.c", shape=ellipse];
  "f:/honey-aws-creds" [label="/honey-aws-creds", shape=ellipse];
  "f:/root/.bashrc" [label="/root/.bashrc", shape=ellipse];
  "f:/runmain.o" [label="/runmain.o", shape=ellipse];
  "f:/sc.iov" [label="/sc.iov", shape=ellipse];
  "f:/sc.tmp" [label="/sc.tmp", shape=ellipse];
  "f:/sp2-hello.elf" [label="/sp2-hello.elf", shape=ellipse];
  "f:/st-hello-emit.c" [label="/st-hello-emit.c", shape=ellipse];
  "f:/st-hello.c" [label="/st-hello.c", shape=ellipse];
  "f:/st_b0" [label="/st_b0", shape=ellipse];
  "f:/st_b1" [label="/st_b1", shape=ellipse];
  "f:/st_b2" [label="/st_b2", shape=ellipse];
  "f:/st_b3" [label="/st_b3", shape=ellipse];
  "f:/st_b4" [label="/st_b4", shape=ellipse];
  "f:/st_b5" [label="/st_b5", shape=ellipse];
  "f:/st_doc.bin" [label="/st_doc.bin", shape=ellipse];
  "f:/tmp/honey-aws-creds" [label="/tmp/honey-aws-creds", shape=ellipse];
  "f:/tmp/welcome" [label="/tmp/welcome", shape=ellipse];
  "p0" -> "f:/etc/crontab" [label="WRITE 53B"];
  "p0" -> "f:/etc/systemd/system/backdoor.service" [label="WRITE 73B"];
  "p0" -> "f:/etc/systemd/system/backdoor.timer" [label="WRITE 83B"];
  "p0" -> "f:/root/.bashrc" [label="WRITE 33B"];
  "p0" -> "f:/sc.iov" [label="WRITE 3B"];
  "p0" -> "f:/sc.tmp" [label="WRITE 5B"];
  "p0" -> "f:/sp2-hello.elf" [label="WRITE 864B"];
  "p0" -> "f:/tmp/honey-aws-creds" [label="READ 200B"];
  "p0" -> "f:/tmp/welcome" [label="READ 46B"];
  "p1" -> "f:/etc/crontab" [label="OPEN 0B"];
  "p1" -> "f:/etc/systemd/system/backdoor.service" [label="OPEN 0B"];
  "p1" -> "f:/etc/systemd/system/backdoor.timer" [label="OPEN 0B"];
  "p1" -> "f:/hello-libc.c" [label="OPEN 0B"];
  "p1" -> "f:/honey-aws-creds" [label="OPEN 0B"];
  "p1" -> "f:/root/.bashrc" [label="OPEN 0B"];
  "p1" -> "f:/runmain.o" [label="OPEN 0B"];
  "p1" -> "f:/runmain.o" [label="READ 128B"];
  "p1" -> "f:/sc.iov" [label="OPEN 0B"];
  "p1" -> "f:/sc.iov" [label="READ 3B"];
  "p1" -> "f:/sc.tmp" [label="OPEN 0B"];
  "p1" -> "f:/sp2-hello.elf" [label="OPEN 0B"];
  "p1" -> "f:/st-hello-emit.c" [label="OPEN 0B"];
  "p1" -> "f:/st-hello-emit.c" [label="READ 394B"];
  "p1" -> "f:/st-hello.c" [label="OPEN 0B"];
  "p1" -> "f:/st-hello.c" [label="READ 399B"];
  "p1" -> "f:/st_b0" [label="OPEN 0B"];
  "p1" -> "f:/st_b1" [label="OPEN 0B"];
  "p1" -> "f:/st_b2" [label="OPEN 0B"];
  "p1" -> "f:/st_b3" [label="OPEN 0B"];
  "p1" -> "f:/st_b4" [label="OPEN 0B"];
  "p1" -> "f:/st_b5" [label="OPEN 0B"];
  "p1" -> "f:/st_doc.bin" [label="OPEN 0B"];
