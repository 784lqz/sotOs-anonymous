 : write-ServerHelloDone ( -- )
 	14 write8 0 write24 ;
 
+\ Write a (decoy) NewSessionTicket (arc-gamma). When we echo the session_ticket
+\ extension in the ServerHello (to match nginx JA3S), RFC 5077 requires us to
+\ send a NewSessionTicket before our ChangeCipherSpec; otherwise an EMS- and
+\ ticket-offering client (e.g. openssl) aborts with "unexpected message". We
+\ have no session cache, so the ticket is an opaque decoy (the 32-byte session
+\ id) with a zero lifetime hint; it is never accepted back for resumption.
+\ Body = ticket_lifetime_hint(4) + ticket<len(2) + 32> = 38 bytes.
+: write-NewSessionTicket ( -- )
+	4 write8 38 write24
+	0 write16 0 write16
+	32 write16 addr-session_id 32 write-blob ;
+
 \ Perform RSA decryption of the client-sent pre-master secret. The value
 \ is in the pad, and its length is provided as parameter.
 cc: do-rsa-decrypt ( len prf_id -- ) {
@@ -1458,6 +1515,13 @@
 			read-ClientKeyExchange
 		then
 		0 read-CCS-Finished
+		\ arc-gamma: if the client offered session_ticket (which we echoed),
+		\ send the NewSessionTicket it now expects, before our CCS. Emitted
+		\ here so it is in the transcript for our Finished and openssl's.
+		addr-ticket_offered get8 if
+			write-NewSessionTicket
+			flush-record
+		then
 		0 write-CCS-Finished
 		save-session
 	then
