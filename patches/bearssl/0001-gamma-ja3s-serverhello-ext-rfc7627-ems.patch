# arc-gamma: byte-exact JA3S for the inbound :443 honeypot.
# Emit ec_point_formats(0x000b)/session_ticket(0x0023)/extended_master_secret(0x0017)
# in the BearSSL ServerHello + implement real server-side RFC 7627 EMS key
# derivation, conditional on the client offer. Echoing session_ticket commits
# us (RFC 5077) to send a NewSessionTicket before our CCS, so we emit a decoy
# NST (no session cache) — without it, an EMS+ticket client (openssl) aborts
# with 'unexpected message'. Applied to pristine BearSSL 0.6 by bootstrap.sh
# after the tarball fetch (patch -p1). Includes the regenerated ssl_hs_server.c
# so no T0 compiler is needed at bootstrap time.
#
--- a/inc/bearssl_ssl.h
+++ b/inc/bearssl_ssl.h
@@ -3439,6 +3439,15 @@
 	uint32_t curves;
 
 	/*
+	 * Client-offered extensions recorded from the ClientHello (arc-gamma,
+	 * for byte-exact ServerHello fingerprint fidelity). Non-zero = offered.
+	 *   ems_offered    : extended_master_secret (RFC 7627, ext 0x0017)
+	 *   ticket_offered : session_ticket (RFC 5077, ext 0x0023)
+	 */
+	unsigned char ems_offered;
+	unsigned char ticket_offered;
+
+	/*
 	 * Context for chain handler.
 	 */
 	const br_ssl_server_policy_class **policy_vtable;
--- a/src/inner.h
+++ b/src/inner.h
@@ -2211,6 +2211,14 @@
 	int prf_id, const void *pms, size_t len);
 
 /*
+ * Variant of br_ssl_engine_compute_master that derives the master secret
+ * over the handshake transcript hash (RFC 7627 Extended Master Secret)
+ * instead of the client/server randoms. Same signature. TLS 1.2 only.
+ */
+void br_ssl_engine_compute_master_ext(br_ssl_engine_context *cc,
+	int prf_id, const void *pms, size_t len);
+
+/*
  * Switch to CBC decryption for incoming records.
  *    cc               the engine context
  *    is_client        non-zero for a client, zero for a server
--- a/src/ssl/ssl_engine.c
+++ b/src/ssl/ssl_engine.c
@@ -1335,6 +1335,32 @@
 		pms, pms_len, "master secret", 2, seed);
 }
 
+/* see inner.h */
+void
+br_ssl_engine_compute_master_ext(br_ssl_engine_context *cc,
+	int prf_id, const void *pms, size_t pms_len)
+{
+	br_tls_prf_impl iprf;
+	unsigned char shash[64];
+	size_t shlen;
+	br_tls_prf_seed_chunk seed[1];
+
+	/*
+	 * RFC 7627 Extended Master Secret: derive over the handshake
+	 * transcript hash (session_hash) instead of client/server randoms.
+	 * br_multihash_out reads the running transcript on a copy (does not
+	 * consume it); at this call site the transcript already contains
+	 * everything through ClientKeyExchange and nothing after. mine2g is
+	 * TLS-1.2-only (0xc02f), so the single-PRF-hash form is correct.
+	 */
+	shlen = br_multihash_out(&cc->mhash, prf_id, shash);
+	seed[0].data = shash;
+	seed[0].len = shlen;
+	iprf = br_ssl_engine_get_PRF(cc, prf_id);
+	iprf(cc->session.master_secret, sizeof cc->session.master_secret,
+		pms, pms_len, "extended master secret", 1, seed);
+}
+
 /*
  * Compute key block.
  */
