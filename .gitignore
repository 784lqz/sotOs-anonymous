# SP1 · vendored TinyCC runtime artifacts (committed binaries, not build
# outputs) · the `-run` startup stub planted into sotfs for `tcc -run`.
!src/test/tcc-bin/runmain.o
# tcc-libc · vendored TinyCC runtime helper lib for hosted (musl) linking.
!src/test/tcc-bin/libtcc1.a
# tcc-libc · vendored STANDARD x86_64 musl (Alpine musl-dev · raw syscall) for
# the /usr sysroot · separate from the OS x86_64_sel4 musl (see VENDOR.md).
!src/test/musl-x86_64/lib/libc.a
!src/test/musl-x86_64/lib/crt1.o
!src/test/musl-x86_64/lib/crti.o
!src/test/musl-x86_64/lib/crtn.o

